{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "incidentId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "tone": {
      "type": "string",
      "enum": [
        "calm",
        "check_in"
      ]
    },
    "suggestedNudge": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "incidentId",
    "title",
    "explanation",
    "tone",
    "suggestedNudge"
  ],
  "additionalProperties": false
}
