{
  "$comment": "Requirement IDs: HEE-KIT-02",
  "$id": "https://chassis/contracts/hee-action-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeeActionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract_version", "contract_hash", "generated_at", "actions", "procedures"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": "1.0.0" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "group", "description", "input_schema", "annotations", "dynamic"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+(_[a-z0-9]+)+$" },
          "title": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "enum": ["read", "change", "verify", "navigate", "collaborate", "cross_boundary"] },
          "description": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "object" },
          "annotations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readOnly", "destructive", "untrustedContent"],
            "properties": {
              "readOnly": { "type": "boolean" },
              "destructive": { "type": "boolean" },
              "untrustedContent": { "type": "boolean" }
            }
          },
          "dynamic": { "type": "boolean" }
        }
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
