{
  "$comment": "Requirement IDs: HEE-EVAL-01, HEE-EVAL-02, HEE-EVAL-03 | Owned by DP-W08 | Per-run results of one agent-surface evaluation iteration.",
  "$id": "https://chassis/contracts/hee-eval-results.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeeEvalIterationResults",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "iteration", "started_at", "finished_at", "arms_run", "repetitions", "scenarios_hash", "safety_hash", "model", "aspect", "note", "manifest_hash", "runs", "metrics", "kept", "kept_reason"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": "1.0.0" },
    "iteration": { "type": "integer", "minimum": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "arms_run": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["treatment", "control"] }
    },
    "repetitions": { "type": "integer", "minimum": 1 },
    "scenarios_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safety_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model": { "type": "string", "minLength": 1 },
    "aspect": { "type": "string", "enum": ["baseline", "descriptions", "schemas", "result_shapes", "action_count"] },
    "note": { "type": "string" },
    "manifest_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "arm", "rep", "passed", "checks", "safety_violation", "rubric", "steps", "stopped", "calls", "tokens", "wall_ms", "model", "final_text", "replayed", "trace_file"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "arm": { "type": "string", "enum": ["treatment", "control"] },
          "rep": { "type": "integer", "minimum": 1 },
          "passed": { "type": "boolean" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check_id", "kind", "passed", "detail"],
              "properties": {
                "check_id": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["success", "safety"] },
                "passed": { "type": "boolean" },
                "detail": { "type": "string" }
              }
            }
          },
          "safety_violation": { "type": "boolean" },
          "rubric": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["verdict", "reason", "model"],
            "properties": {
              "verdict": { "type": "string", "enum": ["pass", "fail"] },
              "reason": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 }
            }
          },
          "steps": { "type": "integer", "minimum": 1 },
          "stopped": { "type": "string", "enum": ["done", "max_steps", "model_error"] },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "ok", "invalid_args", "retry", "error"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "ok": { "type": "boolean" },
                "invalid_args": { "type": "boolean" },
                "retry": { "type": "boolean" },
                "error": { "type": ["string", "null"] }
              }
            }
          },
          "tokens": { "type": "integer", "minimum": 0 },
          "wall_ms": { "type": "number", "minimum": 0 },
          "model": { "type": "string", "minLength": 1 },
          "final_text": { "type": "string" },
          "replayed": { "type": "boolean" },
          "trace_file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment", "control"],
      "properties": {
        "treatment": { "$ref": "#/$defs/armMetrics" },
        "control": { "$ref": "#/$defs/armMetrics" }
      }
    },
    "kept": { "type": "boolean" },
    "kept_reason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "armMetrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["runs", "passed", "pass_rate", "first_pass_valid_rate", "failed_calls", "retries", "tokens_per_run", "wall_s_per_run", "safety_violations", "calls_per_run"],
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "first_pass_valid_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "failed_calls": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "tokens_per_run": { "type": "number", "minimum": 0 },
        "wall_s_per_run": { "type": "number", "minimum": 0 },
        "safety_violations": { "type": "integer", "minimum": 0 },
        "calls_per_run": { "type": "number", "minimum": 0 }
      }
    }
  }
}
