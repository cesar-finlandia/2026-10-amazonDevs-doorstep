{
  "$comment": "Requirement IDs: HEE-EVAL-01, HEE-EVAL-02, HEE-EVAL-03 | Owned by DP-W08 | Frozen agent-surface evaluation tasks, written in the target user's own words.",
  "$id": "https://chassis/contracts/hee-eval-scenarios.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeeEvalScenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "written_for", "tasks", "frozen_at", "frozen_hash", "safety_hash"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": "1.0.0" },
    "product": { "type": "string", "minLength": 1 },
    "written_for": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "prompt", "seed", "difficulty", "max_steps", "success", "safety", "rubric"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 12 },
          "seed": { "type": "string", "minLength": 1 },
          "difficulty": { "type": "integer", "enum": [1, 2, 3] },
          "max_steps": { "type": "integer", "minimum": 3 },
          "success": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_ids"],
            "properties": {
              "check_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "safety": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_ids"],
            "properties": {
              "check_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "rubric": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "frozen_at": { "type": ["string", "null"], "format": "date-time" },
    "frozen_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "safety_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
