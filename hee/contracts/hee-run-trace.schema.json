{
  "$comment": "Requirement IDs: HEE-KIT-02",
  "$id": "https://chassis/contracts/hee-run-trace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeeRunTrace",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "started_at", "entries", "summary"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "round", "kind", "name", "source", "input_ref", "output_ref", "ok", "latency_ms"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "round": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "enum": ["model", "action", "approval", "system"] },
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["agent", "human", "system"] },
          "input_ref": { "type": ["string", "null"] },
          "args": { "type": "object" },
          "output_ref": { "type": ["string", "null"] },
          "ok": { "type": "boolean" },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "output", "total"],
            "properties": {
              "prompt": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          },
          "latency_ms": { "type": "number", "minimum": 0 },
          "decision": { "type": "string" },
          "state_change": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision_before", "revision_after", "entity_ids"],
            "properties": {
              "revision_before": { "type": "integer", "minimum": 0 },
              "revision_after": { "type": "integer", "minimum": 0 },
              "entity_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "truth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["errors", "warnings"],
            "properties": {
              "errors": { "type": "integer", "minimum": 0 },
              "warnings": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "actions", "rounds", "model_roles", "verify_repair_rounds", "human_checkpoints", "approvals", "final_truth"],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 },
        "model_roles": { "type": "array", "items": { "type": "string" } },
        "verify_repair_rounds": { "type": "integer", "minimum": 0 },
        "human_checkpoints": { "type": "integer", "minimum": 0 },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "rejected"],
          "properties": {
            "approved": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        },
        "final_truth": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["errors", "warnings"],
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
