{
  "$comment": "Requirement IDs: HEE-SHOW-01, HEE-SHOW-02, HEE-SHOW-03, HEE-SHOW-04, HEE-CLAIM-01 | Owned by DP-W09 | Claim ledger: every number, comparison and superlative on a non-video surface, each with a source and a ceiling.",
  "$id": "https://chassis/contracts/hee-claims.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeeClaimLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "surfaces", "claims"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "surfaces": { "type": "array", "items": { "type": "string" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "text", "kind", "source", "ceiling", "status", "verified_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "match": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["number", "comparison", "fact", "superlative"] },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "const": "artifact" },
                "path": { "type": "string", "minLength": 1 },
                "pointer": { "type": "string", "minLength": 1 },
                "format": { "type": "string", "minLength": 1 },
                "contains": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "url", "evidence_quote", "checked_at"],
              "properties": {
                "type": { "const": "url" },
                "url": { "type": "string", "format": "uri", "minLength": 1 },
                "evidence_quote": { "type": "string" },
                "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
              }
            }
          ]
        },
        "ceiling": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["verified", "unverified", "retracted"] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
