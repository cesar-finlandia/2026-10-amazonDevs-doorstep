  "selection_rationale": [
    {
      "decision": "include",
      "id": "resilience",
      "reason": "Every Ring/Bedrock call wrapped with golden-cache replay so the live doorway demo never dead-ends on venue Wi-Fi"
    },
    {
      "decision": "include",
      "id": "platform",
      "reason": "The calm timeline UI plus typed event-streaming bus and one-command deploy are the judge-visible product surface"
    },
    {
      "decision": "include",
      "id": "context",
      "reason": "Multi-week household rhythm model must stay inside model context across 21-call triage runs"
    },
    {
      "decision": "include",
      "id": "cost",
      "reason": "Guardrail on every Bedrock triage call prevents a runaway loop burning credits mid-demo"
    },
    {
      "decision": "exclude",
      "id": "data",
      "reason": "Demo runs on real Playground events plus an entry-owned labelled bundle; no chassis synthetic generator needed"
    },
    {
      "decision": "exclude",
      "id": "dev-tooling",
      "reason": "Eval/track/bench verification stays in the chassis; the entry needs no internal rigor tooling to be judged"
    },
    {
      "decision": "include",
      "id": "ideation",
      "reason": "Deck, timed script, golden-demo capture and judge Q&A sheet are the judged packaging artifacts"
    },
    {
      "decision": "exclude",
      "id": "media",
      "reason": "Snapshots need no model; vision wrapper joins only if frame understanding is added later"
    },
    {
      "decision": "include",
      "id": "pgm",
      "reason": "Policy override: profile (included) re-exports ../pgm/roles.js, so pgm must ship or ASM-AC-01 rolls back"
    },
    {
      "decision": "include",
      "id": "profile",
      "reason": "Policy override: ideation (included) depends_on profile per component-catalog; profile holds the under-3-minute video and submission-field facts"
    },
    {
      "decision": "include",
      "id": "provenance",
      "reason": "PROVO disclosure plus SUBMIT formatter satisfy the Devpost disclosure and submission gate"
    },
    {
      "decision": "exclude",
      "id": "assembly-advisory",
      "reason": "Chassis-side advisory tooling is never part of the delivered app"
    }
  ],
  "git": {
    "initialized": true,
    "baseline_commit": "188ac03b5eb203012c271856b26715d498116e57"
  }
